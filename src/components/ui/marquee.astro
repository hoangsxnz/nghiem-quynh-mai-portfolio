---
interface Props {
  items: string[];
  /** Seconds for one full loop. */
  duration?: number;
  ariaLabel: string;
}

const { items, duration = 40, ariaLabel } = Astro.props;
---

<div class="marquee" style={`--duration: ${duration}s`}>
  <ul class="marquee__track" aria-label={ariaLabel}>
    {items.map((item) => <li>{item}</li>)}
  </ul>
  <ul class="marquee__track" aria-hidden="true">
    {items.map((item) => <li>{item}</li>)}
  </ul>
</div>

<style>
  .marquee {
    display: flex;
    width: 100%;
    overflow: hidden;
    padding-block: .75rem;
    border-block: 1px solid color-mix(in srgb, var(--maroon) 25%, transparent);
  }

  .marquee__track {
    display: flex;
    flex-shrink: 0;
    gap: var(--gap);
    margin: 0;
    padding: 0 calc(var(--gap) / 2);
    list-style: none;
    animation: marquee var(--duration) linear infinite;
  }

  .marquee:hover .marquee__track,
  .marquee:focus-within .marquee__track {
    animation-play-state: paused;
  }

  li {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 2vw, 1.6rem);
    color: var(--maroon);
    text-transform: uppercase;
    letter-spacing: .04em;
    white-space: nowrap;
  }

  @keyframes marquee {
    to { transform: translateX(-100%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee {
      overflow: visible;
    }

    .marquee__track {
      flex-wrap: wrap;
      animation: none;
    }

    .marquee__track[aria-hidden='true'] {
      display: none;
    }
  }
</style>
