---
interface Props {
  href: string;
  label: string;
  external?: boolean;
}

const { href, label, external = false } = Astro.props;
---

<a
  class="cta"
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
>
  {label}
  {external && <span class="visually-hidden"> (mở tab mới)</span>}
</a>

<style>
  .cta {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: .55rem 1.4rem;
    background: var(--red);
    color: var(--paper);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    font-family: var(--font-display);
    font-size: 1.125rem;
    letter-spacing: .03em;
    text-transform: uppercase;
    text-decoration: none;
    rotate: -1deg;
    transition: rotate 400ms ease-out, box-shadow 200ms ease-out;
  }

  .cta:hover,
  .cta:focus-visible {
    rotate: 2deg;
    box-shadow: var(--shadow-lg);
  }
</style>
