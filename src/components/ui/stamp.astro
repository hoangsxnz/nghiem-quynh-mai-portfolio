---
interface Props {
  text: string;
  size?: 'sm' | 'md';
}

const { text, size = 'md' } = Astro.props;
---

<span class:list={['stamp', `stamp--${size}`]}>{text}</span>

<style>
  .stamp {
    display: grid;
    place-items: center;
    aspect-ratio: 1.4 / 1;
    padding: .6em 1em;
    border: 2px solid var(--red);
    border-radius: 50%;
    color: var(--red);
    font-family: var(--font-display);
    text-transform: uppercase;
    text-align: center;
    line-height: 1.05;
    letter-spacing: .04em;
    rotate: var(--tilt-3);
  }

  .stamp--sm {
    font-size: 0.8125rem;
    max-width: 7rem;
  }

  .stamp--md {
    font-size: clamp(0.875rem, 1.4vw, 1.125rem);
    max-width: 11rem;
  }
</style>
