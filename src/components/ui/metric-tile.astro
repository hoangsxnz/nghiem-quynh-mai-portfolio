---
interface Props {
  value: string;
  label: string;
  note?: string;
}

const { value, label, note } = Astro.props;
---

<div class="metric" data-reveal>
  <p class="metric__value">{value}</p>
  <p class="metric__label">{label}</p>
  {note && <p class="metric__note">{note}</p>}
</div>

<style>
  .metric {
    display: flex;
    flex-direction: column;
    gap: .25rem;
  }

  .metric__value {
    max-width: none;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: var(--lh-display);
    color: var(--red);
  }

  .metric__label {
    max-width: 24ch;
    font-weight: 600;
    color: var(--maroon);
  }

  .metric__note {
    max-width: 28ch;
    font-size: var(--fs-meta);
    color: var(--muted);
  }
</style>
