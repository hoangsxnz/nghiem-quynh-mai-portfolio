---
import type { FileLink } from '@content-types/content';

type Props = FileLink;

const { label, href, note } = Astro.props;
---

<a class="file-link" href={href} target="_blank" rel="noopener noreferrer">
  <span class="file-link__icon" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" />
      <path d="M14 3v5h5M9 13h6M9 17h4" />
    </svg>
  </span>
  <span class="file-link__text">
    <span class="file-link__label">{label}</span>
    <span class="file-link__note">{note}</span>
  </span>
  <span class="visually-hidden"> (mở tab mới)</span>
</a>

<style>
  .file-link {
    display: inline-flex;
    align-items: center;
    gap: .9rem;
    max-width: 100%;
    min-height: 44px;
    padding: .7rem 1.1rem;
    background: var(--paper);
    border: 2px solid var(--red);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    color: var(--maroon);
    text-decoration: none;
    rotate: var(--tilt-3);
    transition: rotate 300ms ease-out, box-shadow 200ms ease-out, background 200ms ease-out;
  }

  .file-link:hover,
  .file-link:focus-visible {
    rotate: 0deg;
    background: var(--white);
    box-shadow: var(--shadow-lg);
  }

  .file-link__icon {
    flex: none;
    display: grid;
    place-items: center;
    color: var(--red);
  }

  .file-link__text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .file-link__label {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    color: var(--red);
    text-transform: uppercase;
    letter-spacing: .03em;
    overflow-wrap: anywhere;
  }

  .file-link__note {
    font-size: var(--fs-meta);
    color: var(--muted);
  }
</style>
