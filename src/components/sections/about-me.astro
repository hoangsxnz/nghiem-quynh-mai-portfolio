---
import SectionHeader from '@components/ui/section-header.astro';
import Polaroid from '@components/ui/polaroid.astro';
import Sticker from '@components/ui/sticker.astro';
import Marquee from '@components/ui/marquee.astro';
import Timeline from '@components/sections/about/timeline.astro';
import SkillsGrid from '@components/sections/about/skills-grid.astro';
import EducationList from '@components/sections/about/education-list.astro';
import raw from '@data/about.json';
import type { AboutContent } from '@content-types/content';

const about = raw as AboutContent;
---

<section id={about.meta.id} class="section section--alt" aria-labelledby="about-title" data-reveal-group>
  <div class="container">
    <SectionHeader {...about.meta} />

    <div class="about__lead">
      <div class="about__bio">
        {about.bio.map((p) => <p data-reveal>{p}</p>)}
      </div>
      <div class="about__portrait" data-reveal>
        <Polaroid {...about.portrait} width={280} />
      </div>
    </div>

    <article class="objective" data-reveal>
      <h3>{about.objective.title}</h3>
      <p>{about.objective.body}</p>
    </article>

    <blockquote class="quote" data-reveal>{about.quote}</blockquote>

    <ul class="touchpoints" data-reveal>
      {about.touchpoints.map((t, i) => (
        <li>
          <Sticker label={t.label} tilt={((i % 4) + 1) as 1 | 2 | 3 | 4} />
          <span>{t.note}</span>
        </li>
      ))}
    </ul>

    <Timeline eras={about.eras} experience={about.experience} />
    <SkillsGrid skillGroups={about.skillGroups} languages={about.languages} />
  </div>

  <Marquee items={about.tools} ariaLabel="Công cụ sử dụng" />

  <div class="container">
    <EducationList education={about.education} />
  </div>
</section>

<style>
  .about__lead {
    display: flex;
    flex-wrap: wrap-reverse;
    align-items: flex-start;
    gap: var(--gap);
  }

  .about__bio {
    flex: 1 1 28rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .objective {
    padding: 1.5rem;
    background: var(--paper);
    border-left: 4px solid var(--red);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .objective h3 {
    margin-bottom: .5rem;
  }

  .quote {
    padding-left: 1rem;
    border-left: 2px solid var(--red);
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    color: var(--red);
    line-height: 1.25;
  }

  .touchpoints {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap);
    padding: 0;
    list-style: none;
  }

  .touchpoints li {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: .4rem;
  }

  .touchpoints span {
    color: var(--muted);
  }

  /* The marquee is full-bleed, so it sits outside .container. */
  section > :global(.marquee) {
    margin-block: var(--section-y);
  }
</style>
