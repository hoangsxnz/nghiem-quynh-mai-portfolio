---
import SectionHeader from '@components/ui/section-header.astro';
import Marquee from '@components/ui/marquee.astro';
import PhotoStack from '@components/sections/about/photo-stack.astro';
import ExperienceList from '@components/sections/about/experience-list.astro';
import EducationList from '@components/sections/about/education-list.astro';
import SkillsGrid from '@components/sections/about/skills-grid.astro';
import raw from '@data/about.json';
import type { AboutContent } from '@content-types/content';

const about = raw as AboutContent;
---

<section id={about.meta.id} class="section section--alt" aria-labelledby="about-title" data-reveal-group>
  <div class="container">
    <SectionHeader {...about.meta} />

    <div class="about__lead">
      <PhotoStack portraits={about.portraits} />

      <div class="about__text">
        <article class="objective" data-reveal>
          <h3>{about.objective.title}</h3>
          {about.objective.body.map((p) => <p>{p}</p>)}
        </article>

        <blockquote class="quote" data-reveal>{about.quote}</blockquote>
      </div>
    </div>

    <ExperienceList experience={about.experience} />
    <EducationList education={about.education} />
    <SkillsGrid skillGroups={about.skillGroups} languages={about.languages} />
  </div>

  <Marquee items={about.tools} ariaLabel="Công cụ sử dụng" />
</section>

<style>
  /* Photo cluster left, text right — stacks with the photos first below 900px. */
  .about__lead {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    align-items: center;
    gap: clamp(1.5rem, 4vw, 3.5rem);
  }

  .about__text {
    display: flex;
    flex-direction: column;
    gap: var(--gap);
    min-width: 0;
  }

  .objective {
    padding: 1.5rem;
    background: var(--paper);
    border-left: 4px solid var(--red);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .objective h3 {
    margin-bottom: .75rem;
  }

  .objective p + p {
    margin-top: .75rem;
  }

  .quote {
    padding-left: 1rem;
    border-left: 2px solid var(--red);
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    color: var(--red);
    line-height: 1.25;
  }

  @media (max-width: 899px) {
    .about__lead {
      grid-template-columns: 1fr;
    }
  }

  /* The marquee is full-bleed, so it sits outside .container. */
  section > :global(.marquee) {
    margin-block: var(--section-y);
  }
</style>
