---
import SectionHeader from '@components/ui/section-header.astro';
import Sticker from '@components/ui/sticker.astro';
import AgentList from '@components/sections/ai-first/agent-list.astro';
import raw from '@data/ai-first.json';
import type { AiFirstContent } from '@content-types/content';

const ai = raw as AiFirstContent;
---

<section id={ai.meta.id} class="section section--alt" aria-labelledby="ai-first-title" data-reveal-group>
  <div class="container">
    <SectionHeader {...ai.meta} />

    <div data-reveal-group>
      <h3 data-reveal>Bộ công cụ</h3>
      <ul class="tools">
        {ai.tools.map((t, i) => (
          <li data-reveal>
            <Sticker label={t.name} tilt={((i % 4) + 1) as 1 | 2 | 3 | 4} />
            <p>{t.use}</p>
          </li>
        ))}
      </ul>
    </div>

    <div data-reveal-group>
      <h3 data-reveal>Người và AI chia việc ở đâu</h3>
      <ul class="split">
        {ai.workflow.map((w) => (
          <li data-reveal>
            <p class="split__stage">{w.stage}</p>
            <div class="split__cols">
              <div class="split__col">
                <p class="meta">Người</p>
                <p>{w.human}</p>
              </div>
              <div class="split__col split__col--ai">
                <p class="meta">AI</p>
                <p>{w.ai}</p>
              </div>
            </div>
          </li>
        ))}
      </ul>
    </div>

    <AgentList agents={ai.agents} />

    <p class="boundary" data-reveal>{ai.boundary}</p>
  </div>
</section>

<style>
  .tools {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: var(--gap);
    margin-top: var(--gap);
    padding: 0;
    list-style: none;
  }

  .tools li {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: .5rem;
    min-width: 0;
    padding: 1rem 1.1rem;
    background: var(--paper-2);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  /* Four stages stacked as full-width rows: the Người / AI split reads as one
     table rather than four unrelated cards. */
  .split {
    display: flex;
    flex-direction: column;
    gap: .75rem;
    margin-top: var(--gap);
    padding: 0;
    list-style: none;
  }

  .split li {
    min-width: 0;
    padding: 1.25rem;
    background: var(--paper-2);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .split__stage {
    margin-bottom: .75rem;
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--red);
    text-transform: uppercase;
  }

  .split__cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .split__col {
    min-width: 0;
    padding-left: 1rem;
    border-left: 3px solid var(--maroon);
  }

  .split__col--ai {
    border-left-color: var(--red);
  }

  @media (max-width: 560px) {
    .split__cols {
      grid-template-columns: 1fr;
    }
  }

  .boundary {
    max-width: none;
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    color: var(--red);
    line-height: 1.25;
  }
</style>
