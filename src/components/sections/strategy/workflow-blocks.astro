---
import Stamp from '@components/ui/stamp.astro';
import Polaroid from '@components/ui/polaroid.astro';
import type { WorkflowBlock } from '@content-types/content';

interface Props {
  workflow: WorkflowBlock[];
}

const { workflow } = Astro.props;
const pad = (n: number) => String(n + 1).padStart(2, '0');
---

<ol class="workflow" data-reveal-group>
  {workflow.map((block, i) => (
    <li class:list={['block', i % 2 === 1 && 'block--mirror']} data-reveal>
      <div class="block__text">
        <Stamp text={pad(i)} size="sm" />
        <h3>{block.step} <span class="meta">{block.vi}</span></h3>
        <p>{block.body}</p>
      </div>
      {block.image && (
        <div class="block__media">
          <Polaroid
            src={block.image}
            alt={`Ảnh minh họa bước ${block.step} — ${block.vi}`}
            width={420}
            tilt={((i % 4) + 1) as 1 | 2 | 3 | 4}
          />
        </div>
      )}
    </li>
  ))}
</ol>

<style>
  .workflow {
    display: flex;
    flex-direction: column;
    gap: var(--gap);
    padding: 0;
    list-style: none;
  }

  .block {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--gap);
  }

  .block--mirror {
    flex-direction: row-reverse;
  }

  .block__text {
    flex: 1 1 20rem;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: .5rem;
  }

  .block__media {
    flex: 0 1 auto;
    min-width: 0;
  }

  h3 {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: .6rem;
    font-size: var(--fs-h3);
  }

  /* Vietnamese gloss stays sentence case; the display font only styles the English step. */
  h3 .meta {
    font-family: var(--font-body);
    font-weight: 400;
    text-transform: none;
  }

  @media (max-width: 767px) {
    .block,
    .block--mirror {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
