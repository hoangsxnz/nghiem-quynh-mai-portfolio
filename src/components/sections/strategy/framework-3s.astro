---
interface Props {
  framework: { code: string; title: string; body: string }[];
}

const { framework } = Astro.props;
---

<ul class="framework" data-reveal-group>
  {framework.map((f, i) => (
    <li class="card" style={`--tilt: var(--tilt-${(i % 4) + 1})`} data-reveal>
      <p class="code">{f.code}</p>
      <h3>{f.title}</h3>
      <p>{f.body}</p>
    </li>
  ))}
</ul>

<style>
  .framework {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: var(--gap);
    padding: 0;
    list-style: none;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: .5rem;
    min-width: 0;
    padding: 1.5rem;
    background: var(--paper);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    rotate: var(--tilt);
  }

  .code {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    line-height: 1.05;
    color: var(--red);
  }

  h3 {
    font-size: 1.125rem;
  }
</style>
