---
import SectionHeader from '@components/ui/section-header.astro';
import Polaroid from '@components/ui/polaroid.astro';
import FileLink from '@components/ui/file-link.astro';
import ChannelCard from '@components/sections/social/channel-card.astro';
import EvidenceCard from '@components/sections/pika/evidence-card.astro';
import raw from '@data/social.json';
import type { SocialContent } from '@content-types/content';
import Decor from '@components/ui/decor.astro';

const social = raw as SocialContent;
---

<section id={social.meta.id} class="section section--alt" aria-labelledby="social-title" data-reveal-group>
  <Decor src="el-phone-handset.png" w={80} top="0" right="7%" rotate="6deg" opacity={0.42} parallax={0.1} />
  <Decor src="el-scribble-circle.png" w={210} bottom="8%" left="-4%" rotate="-7deg" opacity={0.35} parallax={-0.06} hideMobile />
  <Decor src="el-star-rough.png" w={75} top="16%" right="3%" rotate="11deg" opacity={0.4} parallax={0.07} hideMobile />
  <Decor src="el-cat.png" w={85} top="37%" right="5%" rotate="-8deg" opacity={0.42} parallax={-0.06} hideMobile />
  <Decor src="el-star-glossy.png" w={80} top="43%" left="4%" rotate="-12deg" opacity={0.38} parallax={0.07} hideMobile />
  <Decor src="el-star-rough.png" w={90} top="58%" left="5%" rotate="13deg" opacity={0.4} parallax={-0.07} hideMobile />
  <Decor src="el-cat.png" w={85} top="71%" right="8%" rotate="9deg" opacity={0.4} parallax={0.06} hideMobile />
  <div class="container">
    <SectionHeader {...social.meta} />

    <div class="channel" data-reveal>
      <ChannelCard
        name={social.channel.name}
        meta="Kênh phụ trách"
        href={social.channel.href}
        note={social.channel.handle}
        tilt={2}
      />
      <p>{social.channel.note}</p>
    </div>

    {social.blocks.map((block, i) => (
      <article class:list={['block', i % 2 === 1 && 'block--mirror']} data-reveal-group>
        <div class="block__text">
          <h3 data-reveal>{block.title}</h3>
          <p data-reveal>{block.body}</p>
          {block.links && (
            <ul class="block__links" data-reveal>
              {block.links.map(({ label, href }) => (
                <li>
                  <a href={href} target="_blank" rel="noopener noreferrer">
                    {label}<span class="visually-hidden"> (mở tab mới)</span>
                  </a>
                </li>
              ))}
            </ul>
          )}
        </div>

        <div class:list={['block__media', block.stack && 'block__media--stack']}>
          {block.images.map((img) => (
            <div data-reveal><Polaroid {...img} /></div>
          ))}
        </div>
      </article>
    ))}

    <article class="stats" data-reveal-group>
      <h3 data-reveal>Hiệu suất kênh</h3>
      <EvidenceCard evidence={social.stats} tilt={3} />
      <p class="stats__note meta" data-reveal>{social.statsNote}</p>
    </article>

    <article class="community" data-reveal-group>
      <h3 data-reveal>{social.community.title}</h3>
      <p data-reveal>{social.community.body}</p>
      <EvidenceCard evidence={social.community.evidence} tilt={2} />
      <div data-reveal><FileLink {...social.community.file} /></div>
    </article>
  </div>
</section>

<style>
  .channel {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--gap);
  }

  .channel > :global(.channel) {
    flex: 1 1 18rem;
  }

  .channel > p {
    flex: 1 1 20rem;
  }

  .block {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    align-items: center;
    gap: var(--gap);
  }

  .block--mirror .block__text {
    order: 2;
  }

  .block__text {
    display: flex;
    flex-direction: column;
    gap: .75rem;
    min-width: 0;
  }

  .block__links {
    display: flex;
    flex-direction: column;
    gap: .25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .block__links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
    color: var(--red);
  }

  .block__media {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: center;
    gap: var(--gap);
    min-width: 0;
  }

  /* The feed block's two pictures are consecutive slices of one grid, so they read
     as a stack of prints rather than two separate exhibits. Desktop only: at phone
     width the offset copy would cover the one underneath and push past the gutter. */
  @media (min-width: 900px) {
    .block__media--stack {
      display: grid;
      place-items: start center;
    }

    .block__media--stack > * {
      grid-area: 1 / 1;
    }

    .block__media--stack > :last-child {
      translate: 18% 12%;
    }

    /* The first print carries the caption for the pair, so it stays on top; the
       second peeks out from behind it. */
    .block__media--stack > :first-child {
      z-index: 1;
    }

    /* Without this the lower print can never come forward on hover. */
    .block__media--stack > :hover {
      z-index: 2;
    }
  }

  .stats,
  .community {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--gap);
  }

  .stats__note {
    max-width: 68ch;
  }

  @media (max-width: 899px) {
    .block {
      grid-template-columns: 1fr;
    }

    .block--mirror .block__text {
      order: 0;
    }
  }
</style>
