---
import Polaroid from '@components/ui/polaroid.astro';
import Sticker from '@components/ui/sticker.astro';
import { isPlaceholder } from '@lib/placeholder';
import type { Industry } from '@content-types/content';

interface Props {
  industry: Industry;
  /** Position in the collage: drives both the tilt and the vertical stagger. */
  position: number;
}

const { industry, position } = Astro.props;
const tilt = ((position % 4) + 1) as 1 | 2 | 3 | 4;
---

<li class="industry" style={`--offset: ${position}`} data-reveal>
  <h3>{industry.name}</h3>
  <p class="industry__headline">{industry.headline}</p>

  {isPlaceholder(industry.image)
    ? <div class="industry__gap"><Sticker label="cần bổ sung" tone="maroon" tilt={2} /></div>
    : <Polaroid src={industry.image} alt={`Ảnh minh họa ngành ${industry.name}`} width={360} tilt={tilt} />}

  <dl>
    <dt>Insight</dt>
    <dd>{industry.insight}</dd>
    <dt>Thực thi</dt>
    <dd>{industry.execution}</dd>
  </dl>

  <p class="industry__tagline">{industry.tagline}</p>
</li>

<style>
  .industry {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: .75rem;
    min-width: 0;
    padding: 1.25rem;
    background: var(--paper-2);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  /* Staggered collage: each card sits a little lower than the one before it. */
  @media (min-width: 900px) {
    .industry {
      margin-top: calc(var(--gap) * var(--offset));
    }
  }

  .industry__headline {
    font-weight: 600;
  }

  /* Same footprint as a polaroid so the 3-col rhythm holds without an image. */
  .industry__gap {
    display: grid;
    place-items: center;
    width: 100%;
    aspect-ratio: 1;
    border: 2px dashed var(--red);
    border-radius: var(--radius);
  }

  dl {
    margin: 0;
  }

  dt {
    font-size: var(--fs-meta);
    color: var(--muted);
    letter-spacing: .06em;
    text-transform: uppercase;
  }

  dd {
    margin: 0 0 .75rem;
    max-width: var(--measure);
  }

  .industry__tagline {
    margin-top: auto;
    font-family: var(--font-display);
    color: var(--red);
    line-height: 1.2;
  }
</style>
