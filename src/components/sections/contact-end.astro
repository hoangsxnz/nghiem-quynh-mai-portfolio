---
import CtaButton from '@components/ui/cta-button.astro';
import raw from '@data/contact.json';
import type { ContactContent } from '@content-types/content';

const contact = raw as ContactContent;
---

<section id={contact.meta.id} class="section" aria-labelledby="contact-title" data-reveal-group>
  <div class="container">
    {/* The brief removes the visible section header; the heading stays for a11y. */}
    <h2 id="contact-title" class="visually-hidden">{contact.meta.title}</h2>

    <p class="intro" data-reveal>{contact.intro}</p>

    <ul class="cards" data-reveal>
      {contact.cards.map((card, i) => (
        <li class="card" style={`--tilt: var(--tilt-${(i % 4) + 1})`}>
          <p class="meta">{card.label}</p>
          {card.href
            ? <a href={card.href} target={card.href.startsWith('http') ? '_blank' : undefined} rel={card.href.startsWith('http') ? 'noopener noreferrer' : undefined}>{card.value}</a>
            : <p class="card__value">{card.value}</p>}
        </li>
      ))}
    </ul>

    <div class="cta" data-reveal>
      <CtaButton href={contact.cta.href} label={contact.cta.label} />
    </div>

    <p class="closing" data-closing>{contact.closing}</p>
  </div>
</section>

<footer class="footer">
  <p class="container meta">{contact.footer}</p>
</footer>

<style>
  /* Contact stays tight; overrides the section-wide rhythm in global.css. */
  .section > .container > :global(* + *) {
    margin-top: var(--gap);
  }

  /* Whole block centred, per the brief. */
  .section > .container {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .intro {
    max-width: 62ch;
    font-size: 1.125rem;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: var(--gap);
    width: 100%;
    padding: 0;
    list-style: none;
  }

  .card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: .4rem;
    min-width: 0;
    padding: 1.25rem;
    background: var(--paper-2);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    rotate: var(--tilt);
  }

  .card a,
  .card__value {
    max-width: none;
    font-weight: 600;
    color: var(--maroon);
    overflow-wrap: anywhere;
  }

  .card a {
    display: flex;
    align-items: center;
    min-height: 44px;
  }

  /* Matches the specificity of the section rhythm rule above so it can widen the gap. */
  .section > .container > .closing {
    margin-top: var(--section-y);
  }

  .closing {
    max-width: 20ch;
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    color: var(--red);
    line-height: var(--lh-display);
    text-transform: uppercase;
  }

  .footer {
    padding-block: 2rem;
    border-top: 1px solid color-mix(in srgb, var(--maroon) 20%, transparent);
    text-align: center;
  }
</style>
