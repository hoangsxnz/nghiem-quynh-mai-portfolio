---
import SectionHeader from '@components/ui/section-header.astro';
import CtaButton from '@components/ui/cta-button.astro';
import Sticker from '@components/ui/sticker.astro';
import raw from '@data/contact.json';
import type { ContactContent } from '@content-types/content';

const contact = raw as ContactContent;

/** A placeholder must never ship as a live href. */
const isPlaceholder = (href: string | null) => !!href && href.startsWith('[PLACEHOLDER');
---

<section id={contact.meta.id} class="section" aria-labelledby="contact-title" data-reveal-group>
  <div class="container">
    <SectionHeader {...contact.meta} />
    <p class="intro" data-reveal>{contact.intro}</p>

    <ul class="cards" data-reveal>
      {contact.cards.map((card, i) => (
        <li class="card" style={`--tilt: var(--tilt-${(i % 4) + 1})`}>
          <p class="meta">{card.label}</p>
          {card.href && !isPlaceholder(card.href)
            ? <a href={card.href}>{card.value}</a>
            : <p class="card__value">{card.value}</p>}
          {isPlaceholder(card.href) && <Sticker label="chưa cập nhật" tone="maroon" tilt={2} />}
        </li>
      ))}
    </ul>

    <div class="cta" data-reveal>
      <CtaButton href={contact.cta.href} label={contact.cta.label} />
    </div>

    <p class="closing" data-reveal>{contact.closing}</p>
  </div>
</section>

<footer class="footer">
  <p class="container meta">{contact.footer}</p>
</footer>

<style>
  /* Contact stays tight; overrides the section-wide rhythm in global.css. */
  .section > .container > :global(* + *) {
    margin-top: var(--gap);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: var(--gap);
    padding: 0;
    list-style: none;
  }

  .card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: .4rem;
    padding: 1.25rem;
    background: var(--paper-2);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    rotate: var(--tilt);
  }

  .card a,
  .card__value {
    max-width: none;
    font-weight: 600;
    color: var(--maroon);
    overflow-wrap: anywhere;
  }

  .card a {
    display: flex;
    align-items: center;
    min-height: 44px;
  }

  .closing {
    max-width: none;
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    color: var(--red);
  }

  .footer {
    padding-block: 2rem;
    border-top: 1px solid color-mix(in srgb, var(--maroon) 20%, transparent);
  }
</style>
