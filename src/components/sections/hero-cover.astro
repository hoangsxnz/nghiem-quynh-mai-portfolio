---
import { Image } from 'astro:assets';
import Sticker from '@components/ui/sticker.astro';
import Decor from '@components/ui/decor.astro';
import { image } from '@lib/image-map';
import raw from '@data/hero.json';
import type { HeroContent } from '@content-types/content';

const hero = raw as HeroContent;
const photo = image(hero.photo.src);
---

<section id="hero" class="hero" aria-labelledby="hero-title" data-reveal-group>
  <Decor src="el-star-glossy.png" w={90} top="14%" left="2%" rotate="-12deg" opacity={0.45} parallax={0.09} hideMobile />
  <Decor src="el-squiggle.png" w={190} bottom="6%" left="-2%" rotate="6deg" opacity={0.3} parallax={-0.07} hideMobile />
  <Decor src="el-sparkle.png" w={90} top="8%" right="4%" rotate="10deg" opacity={0.4} parallax={0.06} />
  <Decor src="el-cat.png" w={85} top="4%" left="20%" rotate="-8deg" opacity={0.4} parallax={0.07} hideMobile />
  <Decor src="el-star-rough.png" w={80} bottom="5%" left="16%" rotate="12deg" opacity={0.42} parallax={-0.06} hideMobile />
  <div class="hero__inner container">
    <div class="hero__text">
      <p class="hero__role" data-reveal>{hero.role}</p>
      {/* Decorative repeat of the site title — the accessible name is the h1 below. */}
      <p class="hero__wordmark" aria-hidden="true" data-reveal>{hero.wordmark}</p>
      {/* Plain text only: the word-split reads textContent. */}
      <h1 id="hero-title" data-split>{hero.name}</h1>
      <ul class="hero__tagline" data-reveal>
        {hero.tagline.map((t, i) => (
          <li><Sticker label={t} tilt={((i % 4) + 1) as 1 | 2 | 3 | 4} /></li>
        ))}
      </ul>
      <p class="hero__one-liner" data-reveal>{hero.oneLiner}</p>
      <ul class="hero__links" data-reveal>
        {hero.quickLinks.map(({ label, href }) => (
          <li><a href={href}>{label}</a></li>
        ))}
      </ul>
      <p class="hero__cue meta" data-reveal>{hero.scrollCue}</p>
    </div>

    <div class="hero__media" data-reveal data-parallax="0.1">
      <Image
        class="hero__cutout"
        src={photo}
        alt={hero.photo.alt}
        width={480}
        densities={[1, 1.5]}
        format="webp"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    /* No bottom padding: the cue moved into the text column, so the section no
       longer reserves a centred row for it under the grid. */
    padding-block: clamp(3rem, 8vw, 6rem) 0;
  }

  .hero__inner {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    align-items: center;
    gap: var(--gap);
    flex: 1;
  }

  /* Grid items default to min-width:auto, so the portrait would size the track
     and push the page wider than the viewport. */
  .hero__text,
  .hero__media {
    min-width: 0;
  }

  .hero__text {
    grid-column: 1 / 8;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: .75rem;
  }

  /* English role label, so uppercasing is safe here. */
  .hero__role {
    font-family: var(--font-display);
    font-size: clamp(1rem, 2vw, 1.5rem);
    font-weight: 700;
    color: var(--maroon);
    text-transform: uppercase;
    letter-spacing: .12em;
  }

  .hero__wordmark {
    max-width: none;
    font-family: var(--font-display);
    font-size: var(--fs-h1);
    line-height: var(--lh-display);
    color: var(--red);
    letter-spacing: .02em;
  }

  h1 {
    /* One step below the wordmark, which must stay the largest type on the page. */
    font-size: var(--fs-h2);
    overflow-wrap: break-word;
    margin: 0;
  }

  .hero__tagline,
  .hero__links {
    display: flex;
    flex-wrap: wrap;
    gap: .6rem 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hero__tagline {
    margin-top: .25rem;
  }

  .hero__one-liner {
    font-size: 1.125rem;
  }

  .hero__links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
    color: var(--maroon);
  }

  /* Bottom-aligned: centred, the portrait left a screen-tall empty column between
     its foot and the About Me header on the same side of the page. */
  .hero__media {
    grid-column: 8 / 13;
    justify-self: end;
    align-self: end;
  }

  /* Cut-out portrait: shadow follows the silhouette, so no frame and no background.
     The sticker outline is three stacked zero-offset drop-shadows — each filter runs
     on the previous result, so repeating one thin white glow thickens it into a line
     that hugs the silhouette. `border`/`outline`/`box-shadow` would all trace the
     image's rectangle instead, which is the wrong shape for a transparent PNG. */
  .hero__cutout {
    max-width: 100%;
    height: auto;
    filter:
      drop-shadow(0 0 1.5px var(--white))
      drop-shadow(0 0 1.5px var(--white))
      drop-shadow(0 0 1.5px var(--white))
      drop-shadow(10px 16px 22px rgba(26, 26, 26, .30));
  }

  .hero__cue {
    margin-top: 1rem;
  }

  @media (max-width: 900px) {
    .hero__inner {
      grid-template-columns: 1fr;
    }

    .hero__text,
    .hero__media {
      grid-column: 1;
      justify-self: center;
    }

    .hero__media {
      margin-top: 1.5rem;
    }

    .hero__cutout {
      width: min(260px, 70vw);
    }
  }

  /* Keeps the cover close to a single phone screen instead of pushing the scroll
     cue two viewports down. */
  @media (max-width: 599px) {
    .hero__cutout {
      width: min(190px, 52vw);
    }
  }
</style>
