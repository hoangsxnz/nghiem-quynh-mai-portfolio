---
import SectionHeader from '@components/ui/section-header.astro';
import Sticker from '@components/ui/sticker.astro';
import FileLink from '@components/ui/file-link.astro';
import EvidenceCard from '@components/sections/pika/evidence-card.astro';
import raw from '@data/branding.json';
import type { BrandingContent } from '@content-types/content';

const branding = raw as BrandingContent;
---

<section id={branding.meta.id} class="section" aria-labelledby="branding-title" data-reveal-group>
  <div class="container">
    <SectionHeader {...branding.meta} />

    <p class="statement" data-reveal>{branding.statement}</p>

    <div class="grids">
      <div data-reveal-group>
        <h3 data-reveal>Định vị</h3>
        <ul class="cards">
          {branding.positioning.map((p, i) => (
            <li class="card" style={`--tilt: var(--tilt-${(i % 4) + 1})`} data-reveal>
              <Sticker label={p.label} tilt={3} />
              <p>{p.note}</p>
            </li>
          ))}
        </ul>
      </div>

      <div data-reveal-group>
        <h3 data-reveal>Brand voice</h3>
        <ul class="cards">
          {branding.brandVoice.map((v, i) => (
            <li class="card card--alt" style={`--tilt: var(--tilt-${(i % 4) + 1})`} data-reveal>
              <Sticker label={v.label} tone="maroon" tilt={2} />
              <p>{v.note}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="evidence" data-reveal-group>
      {branding.evidence.map((e, i) => (
        <EvidenceCard evidence={e} tilt={(i % 2 === 0 ? 3 : 2) as 2 | 3} />
      ))}
    </div>

    <div data-reveal>
      <FileLink {...branding.file} />
    </div>
  </div>
</section>

<style>
  .statement {
    max-width: 68ch;
    font-size: 1.125rem;
  }

  .grids {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: var(--section-y) var(--gap);
  }

  .grids > * {
    min-width: 0;
  }

  .grids h3 {
    margin-bottom: var(--gap);
  }

  .cards {
    display: flex;
    flex-direction: column;
    gap: var(--gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: .6rem;
    min-width: 0;
    padding: 1.25rem;
    background: var(--paper-2);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    rotate: var(--tilt);
  }

  .card--alt {
    background: var(--white);
  }

  .card :global(.sticker) {
    white-space: normal;
  }

  .evidence {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap);
  }
</style>
