---
import Stamp from '@components/ui/stamp.astro';
import type { EducationEntry } from '@content-types/content';

interface Props {
  education: EducationEntry[];
}

const { education } = Astro.props;
---

<div class="education" data-reveal-group>
  <h3 data-reveal>Học vấn &amp; Chứng chỉ</h3>
  <ul>
    {education.map((entry, i) => (
      <li
        class:list={['card', `card--${entry.kind}`]}
        style={`--tilt: var(--tilt-${(i % 4) + 1})`}
        data-reveal
      >
        <Stamp text={entry.year} size="sm" />
        <div class="card__text">
          <h4>{entry.title}</h4>
          <p>{entry.note}</p>
        </div>
      </li>
    ))}
  </ul>
</div>

<style>
  .education {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  /* Larger than the neighbouring blocks on purpose — the brief asks for this one
     to read as a highlight rather than a list. */
  .education h3 {
    font-size: var(--fs-h2);
  }

  ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: var(--gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .card {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    min-width: 0;
    padding: 1.5rem;
    background: var(--paper);
    border: 2px solid var(--maroon);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    rotate: var(--tilt);
    transition: rotate 300ms ease-out, box-shadow 300ms ease-out;
  }

  .card:hover {
    rotate: 0deg;
    box-shadow: var(--shadow-lg);
  }

  /* The degree keeps the red stamp and a red edge; certificates step back. */
  .card--degree {
    border-color: var(--red);
  }

  .card--cert :global(.stamp) {
    border-color: var(--maroon);
    color: var(--maroon);
  }

  .card__text {
    min-width: 0;
  }

  h4 {
    font-size: var(--fs-h3);
    font-family: var(--font-display);
    font-weight: 400;
    color: var(--red);
    line-height: var(--lh-display);
    text-transform: uppercase;
  }

  .card__text p {
    margin-top: .35rem;
    color: var(--maroon);
  }
</style>
