---
import type { Job } from '@content-types/content';

interface Props {
  experience: Job[];
}

const { experience } = Astro.props;
---

<div class="experience" data-reveal-group>
  <h3 data-reveal>Kinh nghiệm làm việc</h3>
  <ol class="jobs">
    {experience.map((job) => (
      <li data-reveal>
        <h4>{job.role} — {job.company}</h4>
        <p class="meta">{job.period}</p>
        <ul>
          {job.bullets.map((b) => <li>{b}</li>)}
        </ul>
      </li>
    ))}
  </ol>
</div>

<style>
  .experience {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .jobs {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    margin: 0;
    padding-inline-start: 1.75rem;
    border-inline-start: 2px solid var(--maroon);
    list-style: none;
  }

  .jobs > li {
    position: relative;
  }

  .jobs > li::before {
    content: '';
    position: absolute;
    left: calc(-1.75rem - 7px);
    top: .55em;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--red);
  }

  h4 {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--maroon);
  }

  .jobs ul {
    margin-top: .5rem;
    padding-inline-start: 1.1em;
  }

  .jobs ul li {
    max-width: var(--measure);
    margin-bottom: .35rem;
  }

  .jobs ul li::marker {
    color: var(--red);
  }

  @media (max-width: 767px) {
    .jobs {
      padding-inline-start: 1.1rem;
    }

    .jobs > li::before {
      left: calc(-1.1rem - 5px);
      width: 8px;
      height: 8px;
    }
  }
</style>
