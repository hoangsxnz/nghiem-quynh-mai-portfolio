---
import type { Era, Job } from '@content-types/content';

interface Props {
  eras: Era[];
  experience: Job[];
}

const { eras, experience } = Astro.props;
---

<div class="timeline" data-reveal-group>
  <h3 data-reveal>Hành trình</h3>
  <ol class="eras">
    {eras.map((era) => (
      <li data-reveal>
        <p class="year">{era.range}</p>
        <p class="era-title">{era.title}</p>
        <p>{era.body}</p>
      </li>
    ))}
  </ol>

  <h3 data-reveal>Kinh nghiệm</h3>
  <ol class="jobs">
    {experience.map((job) => (
      <li data-reveal>
        <h4>{job.role} — {job.company}</h4>
        <p class="meta">{job.period}</p>
        <ul>
          {job.bullets.map((b) => <li>{b}</li>)}
        </ul>
      </li>
    ))}
  </ol>
</div>

<style>
  .timeline {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .eras,
  .jobs {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    margin: 0 0 1rem;
    padding-inline-start: 1.75rem;
    border-inline-start: 2px solid var(--maroon);
    list-style: none;
  }

  .eras > li,
  .jobs > li {
    position: relative;
  }

  .eras > li::before,
  .jobs > li::before {
    content: '';
    position: absolute;
    left: calc(-1.75rem - 7px);
    top: .55em;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--red);
  }

  .year {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    color: var(--red);
    line-height: 1.1;
  }

  .era-title {
    font-weight: 600;
  }

  h4 {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--maroon);
  }

  .jobs ul {
    margin-top: .5rem;
    padding-inline-start: 1.1em;
  }

  .jobs ul li {
    max-width: var(--measure);
    margin-bottom: .35rem;
  }

  .jobs ul li::marker {
    color: var(--red);
  }

  @media (max-width: 767px) {
    .eras,
    .jobs {
      padding-inline-start: 1.1rem;
    }

    .eras > li::before,
    .jobs > li::before {
      left: calc(-1.1rem - 5px);
      width: 8px;
      height: 8px;
    }
  }
</style>
