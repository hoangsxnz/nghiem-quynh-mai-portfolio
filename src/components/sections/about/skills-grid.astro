---
import Sticker from '@components/ui/sticker.astro';
import type { SkillGroup } from '@content-types/content';

interface Props {
  skillGroups: SkillGroup[];
  languages: { name: string; level: string }[];
}

const { skillGroups, languages } = Astro.props;
---

<div class="skills" data-reveal-group>
  <h3 data-reveal>Kỹ năng</h3>
  <div class="skills__grid">
    {skillGroups.map((group, i) => (
      <article class:list={['card', i % 2 === 1 && 'card--alt', i % 3 === 2 && 'card--tilt']} data-reveal>
        <h4>{group.title}</h4>
        <ul>
          {group.items.map((item) => (
            <li><Sticker label={item} tone="maroon" tilt={3} /></li>
          ))}
        </ul>
      </article>
    ))}
  </div>

  <h3 data-reveal>Ngôn ngữ</h3>
  <dl class="languages" data-reveal>
    {languages.map(({ name, level }) => (
      <div class="languages__row">
        <dt>{name}</dt>
        <dd>{level}</dd>
      </div>
    ))}
  </dl>
</div>

<style>
  .skills {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  /* Four boxes on one row, as the brief asks; two at tablet, one on a phone. */
  .skills__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gap);
    margin-bottom: 1rem;
  }

  .skills__grid > * {
    min-width: 0;
  }

  @media (min-width: 640px) {
    .skills__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1100px) {
    .skills__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .card {
    padding: 1.25rem;
    background: var(--paper);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .card--alt {
    background: var(--paper-2);
  }

  .card--tilt {
    rotate: var(--tilt-3);
  }

  .card h4 {
    margin-bottom: .75rem;
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--maroon);
  }

  .card ul {
    display: flex;
    flex-wrap: wrap;
    gap: .5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .card :global(.sticker) {
    white-space: normal;
  }

  .languages {
    display: flex;
    flex-direction: column;
    gap: .5rem;
    margin: 0;
  }

  .languages__row {
    display: flex;
    flex-wrap: wrap;
    gap: .5rem 1rem;
    padding-bottom: .5rem;
    border-bottom: 1px solid color-mix(in srgb, var(--maroon) 20%, transparent);
  }

  dt {
    min-width: 9rem;
    font-weight: 600;
  }

  dd {
    margin: 0;
    color: var(--muted);
  }
</style>
