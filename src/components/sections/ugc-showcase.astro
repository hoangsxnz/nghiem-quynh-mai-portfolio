---
import SectionHeader from '@components/ui/section-header.astro';
import CampaignDetail from '@components/sections/ugc/campaign-detail.astro';
import raw from '@data/ugc.json';
import type { UgcContent } from '@content-types/content';

const ugc = raw as UgcContent;
---

<section id={ugc.meta.id} class="section" aria-labelledby="ugc-title" data-reveal-group>
  <div class="container">
    <SectionHeader {...ugc.meta} />

    <blockquote class="belief" data-reveal>{ugc.belief}</blockquote>

    <CampaignDetail campaign={ugc.campaign} />

    <aside class="guardrails" data-reveal>
      <h3>Nguyên tắc khi dùng nội dung của khách</h3>
      <ul>
        {ugc.guardrails.map((g) => <li>{g}</li>)}
      </ul>
    </aside>
  </div>
</section>

<style>
  .belief {
    padding-left: 1rem;
    border-left: 2px solid var(--red);
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    color: var(--red);
    line-height: 1.25;
  }

  .guardrails {
    padding: 1.25rem;
    border: 2px solid var(--maroon);
    border-radius: var(--radius);
  }

  .guardrails h3 {
    margin-bottom: .6rem;
    font-size: 1.0625rem;
    font-family: var(--font-body);
    font-weight: 600;
    color: var(--maroon);
    text-transform: none;
  }

  .guardrails ul {
    padding-inline-start: 1.1em;
  }

  .guardrails li {
    max-width: var(--measure);
    margin-bottom: .3rem;
  }

  .guardrails li::marker {
    color: var(--red);
  }
</style>
